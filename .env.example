# ==============================================================================
# SAKURABOT - ENVIRONMENT VARIABLES CONFIGURATION (.env)
# Copy this file to '.env' and fill in your actual credentials.
# WARNING: NEVER commit your actual '.env' file to Git or share it publicly!
# ==============================================================================

# --- Primary Discord Bot Settings ---
# Your main bot token from Discord Developer Portal: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Default prefix for text commands (e.g. s!, !, ?)
PREFIX=s!

# Discord User ID of the primary bot developer / owner (grants full access to owner commands)
OWNER_ID=1144785664458637394

# Channel ID where system error logs and startup alerts will be posted (set 0 to disable)
LOG_CHANNEL_ID=0

# Comma-separated Role IDs that have permission to manage bot settings across servers
ADMIN_ROLE_IDS=1407948306436329575,1407948771404283915

# Owner contact information displayed on the support and help pages
ZALO_PHONE=0123456789
OWNER_DISCORD_TAG=@your_discord_tag


# --- AI & LLM Service Providers ---
# Google Gemini API key (recommended, obtain free at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API key for ultra-fast LLaMA inference (obtain at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API key for GPT models (optional, obtain at: https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Optional third-party AI provider key
XKIRO_API_KEY=

# Default AI model identifier for conversational responses
AI_MODEL=sensenova/sensenova-6.8-flash-lite


# --- Audio & Lavalink Streaming Configuration ---
# Lavalink v4 server host IP address or domain (default: 127.0.0.1)
LAVALINK_HOST=127.0.0.1

# Lavalink server port (default: 2334)
LAVALINK_PORT=2334

# Lavalink authentication password (set in your application.yml)
LAVALINK_PASSWORD=youshallnotpass

# Comma-separated bot tokens for secondary music workers (enables multi-channel streaming)
MUSIC_TOKENS=bot_music_token_1,bot_music_token_2

# Additional secondary worker bot tokens
TOKENS=bot_sub_token_1,bot_sub_token_2


# --- Web Dashboard & Discord OAuth2 Login ---
# Port on which the Sakura Web Dashboard server listens (default: 10272)
WEB_PORT=10272

# Public or local base URL for the dashboard (e.g. http://localhost:10272 or https://yourdomain.com)
WEB_BASE_URL=http://localhost:10272

# Fallback dashboard access password (legacy support, empty by default)
WEB_PASSWORD=

# Discord Application Client ID for Web OAuth2 authentication
DISCORD_CLIENT_ID=your_discord_client_id_here

# Discord Application Client Secret from Developer Portal -> OAuth2
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# OAuth2 Redirect URI (must match the Redirects configured in Discord Developer Portal)
DISCORD_REDIRECT_URI=http://localhost:10272/api/auth/discord/callback


# --- Minecraft Server & External Cloud APIs (Optional) ---
# Pterodactyl client API key for Minecraft server management
PKMC_API_KEY=

# Falixnodes API key for remote Minecraft hosting control (https://falixnodes.net)
FALIX_API_KEY=

# Auxiliary bot token and channel ID for attendance check-in systems
TOKEN_DIEM_DANH=
MAP_DIEM_DANH_ID=0


# --- Top.gg Bot Listing & Webhook Verification (Optional) ---
# Top.gg API Token for querying remote upvotes
TOPGG_TOKEN=

# Webhook Authorization header for receiving instant vote notifications
TOPGG_WEBHOOK_AUTH=
