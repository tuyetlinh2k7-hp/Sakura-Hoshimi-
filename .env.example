# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG CHO SAKURABOT
# Sao chép file này thành file '.env' và điền các thông tin của bạn vào bên dưới.
# Tuyệt đối KHÔNG chia sẻ hoặc đẩy file '.env' lên GitHub!
# ==============================================================================

# --- BOT DISCORD CHÍNH ---
DISCORD_TOKEN=your_discord_bot_token_here
PREFIX=s!
OWNER_ID=1144785664458637394
LOG_CHANNEL_ID=0
ADMIN_ROLE_IDS=1407948306436329575,1407948771404283915

# Thông tin liên hệ hiển thị trang hỗ trợ
ZALO_PHONE=0123456789
OWNER_DISCORD_TAG=@your_discord_tag

# --- CẤU HÌNH CÁC DỊCH VỤ AI ---
# (Cần ít nhất 1 API key để dùng các tính năng AI chat, bói toán, dịch thuật)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
XKIRO_API_KEY=
AI_MODEL=sensenova/sensenova-6.8-flash-lite

# --- CẤU HÌNH PHÁT NHẠC (LAVALINK) ---
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2334
LAVALINK_PASSWORD=youshallnotpass

# Danh sách token bot phụ chạy song song để phát nhạc nhiều kênh (ngăn cách bằng dấu phẩy)
MUSIC_TOKENS=bot_music_token_1,bot_music_token_2
TOKENS=bot_sub_token_1,bot_sub_token_2

# --- CẤU HÌNH SAKURA WEB DASHBOARD ---
WEB_PORT=10272
WEB_BASE_URL=http://localhost:10272
WEB_PASSWORD=

# --- DISCORD OAUTH2 (Dành cho đăng nhập Web Dashboard) ---
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:10272/api/auth/discord/callback

# --- TÍCH HỢP MINECRAFT & CLOUD API (Tùy chọn) ---
PKMC_API_KEY=
FALIX_API_KEY=

# --- TOP.GG VOTE (Tùy chọn) ---
TOPGG_TOKEN=
TOPGG_WEBHOOK_AUTH=
